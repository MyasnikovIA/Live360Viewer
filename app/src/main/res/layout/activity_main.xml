<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_idle"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingBottom="8dp" />

        <!-- Photo resolution (JPEG) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Photo resolution (JPEG):" />

        <Spinner
            android:id="@+id/spPhotoRes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- Video resolution (live H.264 stream) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Video resolution (live stream):" />

        <Spinner
            android:id="@+id/spVideoRes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Кнопки -->
        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check camera" />

        <Button
            android:id="@+id/btnStartSphere"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Sphere (3D)" />

        <Button
            android:id="@+id/btnStartFlat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Flat (360×180)" />

        <Button
            android:id="@+id/btnStartStream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Stream (TCP server)" />

        <Button
            android:id="@+id/btnStartClient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Stream Client (send to remote)" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stop" />

        <!-- Лог -->
        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>